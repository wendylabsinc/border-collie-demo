{
  "appId": "border-collie-pear-evidence-probe",
  "version": "0.1.0",
  "services": {
    "probe": {
      "context": ".",
      "env": {
        "UNITREE_ROBOT_IP": "192.168.123.161",
        "PEAR_PROBE_DURATION_S": "60",
        "PEAR_CONFIDENCE_THRESHOLD": "0.35",
        "PEAR_REQUIRED_MATCH_RATIO": "0.80",
        "PEAR_MINIMUM_SAMPLES": "30",
        "PEAR_SNAPSHOT_PORT": "8123"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {"type": "gpu"}
      ]
    }
  }
}
