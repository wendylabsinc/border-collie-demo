# DLO deployment control. Never selected by wendy.json.
# syntax=docker/dockerfile:1.6

ARG CYCLONEDDS_VERSION=0.10.5
ARG UNITREE_SDK2_PYTHON_REF=e4cd91f051aaa77a70600e3d2bf7f50889db1980

FROM python:3.11-slim-bookworm AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG CYCLONEDDS_VERSION
ARG UNITREE_SDK2_PYTHON_REF

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates \
    && git clone --depth 1 --branch ${CYCLONEDDS_VERSION} \
      https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds \
    && cmake -S /tmp/cyclonedds -B /tmp/cyclonedds/build \
      -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF \
    && cmake --build /tmp/cyclonedds/build -j2 \
    && cmake --install /tmp/cyclonedds/build \
    && ldconfig \
    && rm -rf /tmp/cyclonedds /var/lib/apt/lists/*

ENV CYCLONEDDS_HOME=/usr/local

WORKDIR /app
COPY pyproject.toml README.md ./
RUN mkdir -p src/border_collie_demo \
    && touch src/border_collie_demo/__init__.py \
    && python -m venv /opt/border-collie-venv \
    && /opt/border-collie-venv/bin/python -m pip install --no-cache-dir --upgrade pip \
    && /opt/border-collie-venv/bin/python -m pip install --no-cache-dir --no-deps \
      "git+https://github.com/unitreerobotics/unitree_sdk2_python.git@${UNITREE_SDK2_PYTHON_REF}" \
    && /opt/border-collie-venv/bin/python -m pip install --no-cache-dir '.[robot]'
COPY src/ src/
RUN /opt/border-collie-venv/bin/python -m pip install --no-cache-dir .

FROM python:3.11-slim-bookworm AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local
COPY --from=builder /opt/border-collie-venv /opt/border-collie-venv

ENV PATH=/opt/border-collie-venv/bin:$PATH \
    CYCLONEDDS_HOME=/usr/local \
    PYTHONUNBUFFERED=1 \
    BORDER_COLLIE_PORT=8110 \
    BORDER_COLLIE_HARDWARE_ENABLED=0 \
    BORDER_COLLIE_LAB_MOTION_ENABLED=0 \
    GO2_NETWORK_INTERFACE=enP8p1s0

WORKDIR /app
COPY web/ web/

EXPOSE 8110

CMD ["border-collie-demo"]
