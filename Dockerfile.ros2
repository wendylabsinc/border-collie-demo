FROM ros:humble-ros-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3-pip python3-dev alsa-utils git build-essential cmake pkg-config \
       ca-certificates libssl-dev ros-humble-geometry-msgs ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

ARG CYCLONEDDS_VERSION=0.10.5
RUN git clone --depth 1 --branch ${CYCLONEDDS_VERSION} \
        https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds \
    && cmake -S /tmp/cyclonedds -B /tmp/cyclonedds/build \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF -DBUILD_IDLC=ON \
    && cmake --build /tmp/cyclonedds/build -j2 \
    && cmake --install /tmp/cyclonedds/build \
    && ldconfig \
    && rm -rf /tmp/cyclonedds

ENV CYCLONEDDS_HOME=/usr/local \
    LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts/generate_bark.py /tmp/generate_bark.py
RUN python3 -m pip install --no-cache-dir .
RUN python3 -m pip install --no-cache-dir cyclonedds==0.10.5 \
    "git+https://github.com/unitreerobotics/unitree_sdk2_python.git@db9b2d210081387fcd1e7ed9ac4c56a02983bb85" \
    && mkdir -p /usr/local/lib/python3.10/dist-packages/unitree_sdk2py/b2
COPY stage-assets/unitree_b2_init.py /usr/local/lib/python3.10/dist-packages/unitree_sdk2py/b2/__init__.py

RUN mkdir -p /opt/robotkit/assets \
    && python3 /tmp/generate_bark.py /opt/robotkit/assets/bark.wav \
    && rm /tmp/generate_bark.py

RUN useradd --create-home --uid 10001 robotkit \
    && chown -R robotkit:robotkit /app
USER robotkit

CMD ["python3", "-m", "robotkit.executor.service"]
