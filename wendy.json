{
  "appId": "sh.wendy.robotkit.go2",
  "platform": "linux",
  "version": "0.1.0",
  "resources": {
    "memory": "512Mi",
    "cpus": "0.5"
  },
  "services": {
    "world-state": {
      "resources": {
        "cpus": "1"
      },
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "persist", "name": "robotkit-world-state", "path": "/data" }
      ]
    },
    "yolo-fruits": {
      "resources": {
        "memory": "4Gi",
        "cpus": "2"
      },
      "frameworks": {
        "ros2": {
          "domainId": 0,
          "rmw": "cyclonedds",
          "distro": "humble",
          "discoveryScope": "host"
        }
      },
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "gpu" },
        { "type": "persist", "name": "robotkit-model-cache", "path": "/models" }
      ]
    },
    "lidar-voxel": {
      "resources": {
        "memory": "1Gi",
        "cpus": "2"
      },
      "frameworks": {
        "ros2": {
          "domainId": 0,
          "rmw": "cyclonedds",
          "distro": "humble",
          "discoveryScope": "host"
        }
      },
      "entitlements": [{ "type": "network", "mode": "host" }]
    },
    "transcription": {
      "resources": {
        "memory": "2Gi",
        "cpus": "2"
      },
      "frameworks": {
        "ros2": {
          "domainId": 0,
          "rmw": "cyclonedds",
          "distro": "humble",
          "discoveryScope": "host"
        }
      },
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "audio" },
        { "type": "persist", "name": "robotkit-model-cache", "path": "/models" }
      ]
    },
    "website-command": {
      "entitlements": [{ "type": "network", "mode": "host" }]
    },
    "health-high-low": {
      "frameworks": {
        "ros2": {
          "domainId": 0,
          "rmw": "cyclonedds",
          "distro": "humble",
          "discoveryScope": "host"
        }
      },
      "entitlements": [{ "type": "network", "mode": "host" }]
    },
    "planner": {
      "resources": {
        "cpus": "1"
      },
      "entitlements": [{ "type": "network", "mode": "host" }]
    },
    "controller": {
      "resources": {
        "cpus": "1"
      },
      "entitlements": [{ "type": "network", "mode": "host" }]
    },
    "executor": {
      "resources": {
        "memory": "1Gi",
        "cpus": "1"
      },
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "audio" }
      ]
    }
  }
}
