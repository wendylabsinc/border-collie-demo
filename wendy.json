{
  "appId": "border-collie-demo",
  "version": "1.1.11-stage-default",
  "services": {
    "app": {
      "context": ".",
      "env": {
        "BORDER_COLLIE_PORT": "8110",
        "BORDER_COLLIE_BUILD_LABEL": "stage-default-v12-controller-progressive-lock",
        "BORDER_COLLIE_OPERATOR_LOG_ENABLED": "1",
        "BORDER_COLLIE_RUNTIME_MODE": "production",
        "BORDER_COLLIE_HARDWARE_ENABLED": "1",
        "BORDER_COLLIE_AUTONOMY_ENABLED": "1",
        "BORDER_COLLIE_CONTROLLER_START_ENABLED": "1",
        "BORDER_COLLIE_LAB_MOTION_ENABLED": "0",
        "BORDER_COLLIE_PERCEPTION_ENABLED": "1",
        "BORDER_COLLIE_PERCEPTION_STATUS_URL": "http://127.0.0.1:8111/status",
        "BORDER_COLLIE_PERCEPTION_TARGET_URL": "http://127.0.0.1:8111/api/target",
        "BORDER_COLLIE_PERCEPTION_FRAME_URL": "http://127.0.0.1:8111/api/camera/frame.jpg",
        "BORDER_COLLIE_PERCEPTION_TIMEOUT_S": "0.25",
        "BORDER_COLLIE_BARK_ENABLED": "1",
        "BORDER_COLLIE_BARK_URL": "http://127.0.0.1:8111/api/bark",
        "BORDER_COLLIE_THERMAL_BEEP_URL": "http://127.0.0.1:8111/api/thermal/beep",
        "BORDER_COLLIE_BARK_STATUS_URL": "http://127.0.0.1:8111/status",
        "BORDER_COLLIE_SYSTEM_AUDIO_POLICY": "muted_except_bark",
        "BORDER_COLLIE_BARK_VOLUME": "6",
        "BORDER_COLLIE_BARK_AUDIBLE_S": "2.0",
        "BORDER_COLLIE_THERMAL_ALERT_VOLUME": "10",
        "BORDER_COLLIE_THERMAL_ALERT_AUDIBLE_S": "1.25",
        "BORDER_COLLIE_EVIDENCE_BASE_URL": "http://127.0.0.1:8111/",
        "BORDER_COLLIE_EVIDENCE_TIMEOUT_S": "3.0",
        "BORDER_COLLIE_RUNS_DIR": "/state/runs",
        "BORDER_COLLIE_HOME_RECORDING_EVENTS_DIR": "/state/home-recorder/events",
        "BORDER_COLLIE_HOME_RECORDINGS_DIR": "/state/home-recorder/runs",
        "BORDER_COLLIE_HOME_RECORDER_STATUS_URL": "http://127.0.0.1:8112/status",
        "BORDER_COLLIE_HOME_ALIGN_YAW_RPS": "0.80",
        "BORDER_COLLIE_HOME_ARRIVAL_TOLERANCE_M": "0.50",
        "BORDER_COLLIE_HOME_STALL_TIMEOUT_S": "5.0",
        "BORDER_COLLIE_HOME_SETTLE_INTERVAL_S": "0.30",
        "BORDER_COLLIE_HOME_SETTLED_SAMPLE_COUNT": "4",
        "BORDER_COLLIE_HOME_SETTLED_MAX_SPREAD_M": "0.03",
        "BORDER_COLLIE_HOME_SETTLED_SAMPLE_TIMEOUT_S": "1.0",
        "BORDER_COLLIE_HOME_SETTLED_RETRY_COUNT": "1",
        "BORDER_COLLIE_STAGE_HOME_MARGIN_M": "0.50",
        "BORDER_COLLIE_FORWARD_PULSE_MPS": "0.50",
        "BORDER_COLLIE_FORWARD_PULSE_DURATION_S": "0.40",
        "BORDER_COLLIE_MAX_FORWARD_MPS": "1.0",
        "BORDER_COLLIE_GUIDANCE_SEARCH_YAW_RPS": "0.50",
        "BORDER_COLLIE_GUIDANCE_FOCUS_YAW_RPS": "0.50",
        "BORDER_COLLIE_GUIDANCE_PROGRESSIVE_FOCUS_YAW_ENABLED": "1",
        "BORDER_COLLIE_GUIDANCE_FOCUS_YAW_STEP_RPS": "0.10",
        "BORDER_COLLIE_GUIDANCE_FOCUS_MINIMUM_YAW_RPS": "0.50",
        "BORDER_COLLIE_GUIDANCE_FOCUS_MISSING_GRACE_S": "0.50",
        "BORDER_COLLIE_BEARING_ROUTING_ENABLED": "1",
        "BORDER_COLLIE_APPLE_FOCUS_CONFIDENCE": "0.40",
        "BORDER_COLLIE_APPLE_ACQUISITION_CONFIDENCE": "0.40",
        "BORDER_COLLIE_GUIDANCE_SEARCH_SWEEP_RAD": "6.283185307179586",
        "BORDER_COLLIE_GUIDANCE_CENTER_TOLERANCE_RATIO": "0.05",
        "BORDER_COLLIE_GUIDANCE_CENTER_CONFIRMATIONS": "3",
        "BORDER_COLLIE_GUIDANCE_APPROACH_FORWARD_MPS": "1.0",
        "BORDER_COLLIE_GUIDANCE_APPROACH_YAW_RPS": "0.30",
        "BORDER_COLLIE_GUIDANCE_OUTER_CORRIDOR_RATIO": "0.20",
        "BORDER_COLLIE_GUIDANCE_RECENTER_YAW_RPS": "0.50",
        "BORDER_COLLIE_GUIDANCE_DUPLICATE_HOLD_S": "0.250",
        "BORDER_COLLIE_GUIDANCE_SOURCE_MAXIMUM_AGE_S": "0.350",
        "BORDER_COLLIE_GUIDANCE_DETECTION_MAXIMUM_AGE_S": "0.250",
        "BORDER_COLLIE_GUIDANCE_SLOW_INFERENCE_GRACE_S": "0.50",
        "BORDER_COLLIE_GUIDANCE_NEAR_BOTTOM_RATIO": "0.90",
        "BORDER_COLLIE_GUIDANCE_DISAPPEARANCE_BOTTOM_RATIO": "0.80",
        "BORDER_COLLIE_GUIDANCE_NEAR_CENTER_RATIO": "0.72",
        "BORDER_COLLIE_GUIDANCE_NEAR_CONFIRMATIONS": "3",
        "BORDER_COLLIE_GUIDANCE_NEAR_LOSS_CONFIRMATIONS": "2",
        "BORDER_COLLIE_GUIDANCE_NEAR_LOSS_GRACE_S": "0.75",
        "BORDER_COLLIE_GUIDANCE_FINAL_PUSH_MPS": "0.60",
        "BORDER_COLLIE_GUIDANCE_FINAL_PUSH_DURATION_S": "1.0",
        "BORDER_COLLIE_COMMAND_WATCHDOG_S": "0.35",
        "BORDER_COLLIE_RPC_TIMEOUT_S": "5.0",
        "BORDER_COLLIE_RPC_SLOW_THRESHOLD_S": "1.0",
        "GO2_NETWORK_INTERFACE": "enP8p1s0"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {
          "type": "persist",
          "name": "border-collie-demo-recordings",
          "path": "/state"
        }
      ]
    },
    "home-recorder": {
      "context": "./home-recorder",
      "env": {
        "HOME_RECORDER_PORT": "8112",
        "HOME_RECORDER_STATE_DIR": "/state/home-recorder",
        "HOME_RECORDER_EVENTS_DIR": "/state/home-recorder/events",
        "HOME_RECORDER_MAX_EVENTS_PER_RUN": "10000",
        "HOME_RECORDER_YAW_DRIFT_THRESHOLD_M": "0.03",
        "HOME_RECORDER_COMMAND_ACTIVE_S": "0.50",
        "GO2_NETWORK_INTERFACE": "enP8p1s0"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {
          "type": "persist",
          "name": "border-collie-demo-recordings",
          "path": "/state"
        }
      ]
    },
    "media": {
      "context": "./media",
      "env": {
        "UNITREE_ROBOT_IP": "192.168.123.161",
        "PEAR_MODEL_PATH": "/media/model.engine",
        "BANANA_SPECIALIST_MODEL_PATH": "/media/banana-specialist.pt",
        "BANANA_SPECIALIST_MIN_CONFIDENCE": "0.55",
        "BANANA_SPECIALIST_MIN_IOU": "0.10",
        "BORDER_COLLIE_BARK_UUID": "161387de-21ab-4f0b-b4e9-97124b000d06",
        "EVIDENCE_MAXIMUM_FRAMES": "40",
        "EVIDENCE_FRAME_INTERVAL_S": "0.5"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {"type": "gpu"}
      ]
    },
    "voice": {
      "context": "./voice",
      "dependsOn": ["app", "media"],
      "env": {
        "PORT": "8092",
        "ACTION_MODE": "border_collie",
        "BORDER_COLLIE_URL": "http://127.0.0.1:8110",
        "BORDER_COLLIE_EXPECTED_BUILD_LABEL": "stage-default-v12-controller-progressive-lock",
        "CONTINUOUS_TRANSCRIPTION": "0",
        "AUTO_ARM_ACTIONS": "1",
        "AUDIO_DEVICE": "DJI MIC MINI",
        "MICROPHONE_RETRY_INTERVAL_S": "2.0",
        "WAKE_WORD": "/app/hey_wendy.onnx",
        "WAKE_THRESHOLD": "0.5",
        "COMMAND_WINDOW_S": "8",
        "OWW_MELSPEC_PATH": "/opt/openwakeword-models/melspectrogram.onnx",
        "OWW_EMBEDDING_PATH": "/opt/openwakeword-models/embedding_model.onnx"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {"type": "audio"},
        {
          "type": "persist",
          "name": "border-collie-parakeet-models",
          "path": "/models"
        }
      ]
    }
  },
  "readiness": {
    "tcpSocket": {"port": 8110},
    "timeoutSeconds": 45
  }
}
