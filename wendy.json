{
  "appId": "border-collie-demo",
  "version": "1.0.17-durability",
  "services": {
    "app": {
      "context": ".",
      "env": {
        "BORDER_COLLIE_PORT": "8110",
        "BORDER_COLLIE_BUILD_LABEL": "durability-foundation-v14-monotonic-lidar-handoff (codex/durability-approach-cadence)",
        "BORDER_COLLIE_RELEASE_ID": "durability-foundation-v14-monotonic-lidar-handoff",
        "BORDER_COLLIE_CONFIG_SCHEMA": "2",
        "BORDER_COLLIE_RUNTIME_MODE": "production",
        "BORDER_COLLIE_HARDWARE_ENABLED": "1",
        "BORDER_COLLIE_AUTONOMY_ENABLED": "1",
        "BORDER_COLLIE_LAB_MOTION_ENABLED": "0",
        "BORDER_COLLIE_PERCEPTION_ENABLED": "1",
        "BORDER_COLLIE_PERCEPTION_STATUS_URL": "http://127.0.0.1:8111/status",
        "BORDER_COLLIE_PERCEPTION_TARGET_URL": "http://127.0.0.1:8111/api/target",
        "BORDER_COLLIE_PERCEPTION_FRAME_URL": "http://127.0.0.1:8111/api/camera/frame.jpg",
        "BORDER_COLLIE_PERCEPTION_TIMEOUT_S": "0.25",
        "BORDER_COLLIE_BARK_ENABLED": "1",
        "BORDER_COLLIE_BARK_URL": "http://127.0.0.1:8111/api/bark",
        "BORDER_COLLIE_BARK_STATUS_URL": "http://127.0.0.1:8111/status",
        "BORDER_COLLIE_EVIDENCE_BASE_URL": "http://127.0.0.1:8111/",
        "BORDER_COLLIE_EVIDENCE_TIMEOUT_S": "3.0",
        "BORDER_COLLIE_RUNS_DIR": "/var/lib/border-collie-demo/runs",
        "BORDER_COLLIE_FORWARD_PULSE_MPS": "0.55",
        "BORDER_COLLIE_MIN_FORWARD_MPS": "0.55",
        "BORDER_COLLIE_FORWARD_PULSE_DURATION_S": "0.40",
        "BORDER_COLLIE_MAX_FORWARD_MPS": "1.0",
        "BORDER_COLLIE_COMMAND_WATCHDOG_S": "0.35",
        "BORDER_COLLIE_BREADCRUMB_SPACING_M": "0.20",
        "BORDER_COLLIE_BREADCRUMB_REACH_M": "0.25",
        "BORDER_COLLIE_MAXIMUM_BREADCRUMBS": "128",
        "BORDER_COLLIE_FOOT_CONTACT_MIN_FORCE": "5.0",
        "BORDER_COLLIE_STATIONARY_MAX_SPEED_MPS": "0.05",
        "BORDER_COLLIE_STATIONARY_MAX_YAW_RATE_RPS": "0.08",
        "BORDER_COLLIE_FORWARD_RANGE_INDEX": "0",
        "BORDER_COLLIE_RANGE_SENSOR_TO_FRONT_ENVELOPE_M": "0.0",
        "BORDER_COLLIE_RANGE_SENSOR_LATENCY_S": "0.20",
        "BORDER_COLLIE_RANGE_BRAKING_DISTANCE_M": "0.02",
        "BORDER_COLLIE_RANGE_NOISE_M": "0.02",
        "BORDER_COLLIE_ARRIVAL_CLEARANCE_M": "0.4572",
        "BORDER_COLLIE_ARRIVAL_CLEARANCE_TOLERANCE_M": "0.0508",
        "BORDER_COLLIE_RANGE_MAXIMUM_AGE_S": "0.30",
        "BORDER_COLLIE_LIDAR_HANDOFF_ENABLED": "1",
        "BORDER_COLLIE_LIDAR_FRONT_ENVELOPE_M": "0.30",
        "BORDER_COLLIE_LIDAR_MAXIMUM_AGE_S": "0.30",
        "BORDER_COLLIE_LIDAR_MAXIMUM_HANDOFF_S": "2.0",
        "BORDER_COLLIE_LIDAR_MIN_NEAREST_SEPARATION_M": "0.20",
        "BORDER_COLLIE_CAMERA_HORIZONTAL_FOV_DEG": "90.0",
        "BORDER_COLLIE_LIDAR_CAMERA_BEARING_TOLERANCE_DEG": "6.0",
        "GO2_NETWORK_INTERFACE": "enP8p1s0"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {
          "type": "persist",
          "name": "border-collie-demo-runs",
          "path": "/var/lib/border-collie-demo/runs"
        }
      ]
    },
    "media": {
      "context": "./media",
      "env": {
        "UNITREE_ROBOT_IP": "192.168.123.161",
        "BORDER_COLLIE_RELEASE_ID": "durability-foundation-v14-monotonic-lidar-handoff",
        "BORDER_COLLIE_CONFIG_SCHEMA": "2",
        "PEAR_MODEL_PATH": "/media/model.engine",
        "BANANA_SPECIALIST_MODEL_PATH": "/media/banana-specialist.pt",
        "BANANA_SPECIALIST_MIN_CONFIDENCE": "0.55",
        "BANANA_SPECIALIST_MIN_IOU": "0.10",
        "BORDER_COLLIE_BARK_UUID": "161387de-21ab-4f0b-b4e9-97124b000d06",
        "MEDIA_CONNECT_TIMEOUT_S": "15.0",
        "MEDIA_CLEANUP_TIMEOUT_S": "5.0",
        "MEDIA_SUPERVISION_INTERVAL_S": "0.10",
        "MEDIA_STABLE_FRAME_COUNT": "10",
        "MEDIA_FRAME_STALL_TIMEOUT_S": "0.75",
        "MEDIA_FIRST_FRAME_TIMEOUT_S": "3.0",
        "MEDIA_RESTART_BUDGET": "5",
        "MEDIA_INITIAL_BACKOFF_S": "8.0",
        "MEDIA_MAXIMUM_BACKOFF_S": "30.0",
        "EVIDENCE_MAXIMUM_FRAMES": "40",
        "EVIDENCE_FRAME_INTERVAL_S": "0.5",
        "VISUAL_ODOMETRY_ENABLED": "1",
        "VISUAL_ODOMETRY_INTERVAL_S": "0.10",
        "VISUAL_ODOMETRY_MAX_INTERVAL_S": "0.50",
        "VISUAL_ODOMETRY_PROCESSING_BUDGET_S": "0.030",
        "VISUAL_ODOMETRY_PROCESSING_WIDTH_PX": "424",
        "VISUAL_ODOMETRY_MAX_FEATURES": "800",
        "VISUAL_ODOMETRY_MIN_TRACKS": "30",
        "VISUAL_ODOMETRY_MAX_KEYFRAMES": "48",
        "VISUAL_ODOMETRY_HORIZONTAL_FOV_DEG": "90.0",
        "VISUAL_ODOMETRY_CAMERA_TO_BODY_YAW_RAD": "0.0"
      },
      "entitlements": [
        {"type": "network", "mode": "host"},
        {"type": "gpu"}
      ]
    }
  },
  "readiness": {
    "tcpSocket": {"port": 8110},
    "timeoutSeconds": 45
  }
}
