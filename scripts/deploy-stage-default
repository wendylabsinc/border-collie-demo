#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
cd "$project_dir"

# Wendy persists this policy and reconciles the app group after device boot.
# An explicit operator stop remains stopped until the next explicit start/run.
exec "${WENDY_BIN:-wendy}" run --detach --restart-unless-stopped "$@"
