#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="${FRUIT_SOAK_PYTHON:-}"
if [[ -z "${python_bin}" ]]; then
  for candidate in "${repo_root}/.venv314/bin/python" "${repo_root}/.venv/bin/python"; do
    if [[ -x "${candidate}" ]]; then
      python_bin="${candidate}"
      break
    fi
  done
fi
if [[ -z "${python_bin}" ]] && command -v python3.14 >/dev/null 2>&1; then
  python_bin="$(command -v python3.14)"
fi
python_bin="${python_bin:-python3}"

command="${1:-}"
if [[ -z "${command}" ]]; then
  echo "usage: scripts/fruit-soak {test|run} [arguments...]" >&2
  exit 2
fi
shift

case "${command}" in
  test)
    cd "${repo_root}"
    exec "${python_bin}" -m pytest -q tests/test_fruit_soak.py "$@"
    ;;
  run)
    cd "${repo_root}"
    exec "${python_bin}" scripts/fruit_soak.py \
      --recover-failures \
      --stage-home-margin "${FRUIT_SOAK_HOME_MARGIN_M:-0.50}" \
      "$@"
    ;;
  check)
    cd "${repo_root}"
    exec "${python_bin}" scripts/fruit_soak.py --check-only "$@"
    ;;
  *)
    echo "unknown command: ${command}; expected check, test, or run" >&2
    exit 2
    ;;
esac
